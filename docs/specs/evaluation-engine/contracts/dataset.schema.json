{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evaluation-lab/schemas/dataset.json",
  "title": "Dataset",
  "type": "object",
  "required": ["id", "name", "version", "cases"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique dataset identifier, e.g. service-desk-mvp"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Simple semver, e.g. 0.1.0"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evaluation-case.schema.json" },
      "description": "All case ids must be unique within the array (enforced by the loader, not expressible in plain JSON Schema)"
    }
  }
}
