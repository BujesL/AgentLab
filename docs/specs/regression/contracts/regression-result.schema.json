{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evaluation-lab/schemas/regression-result.json",
  "title": "RegressionResult",
  "type": "object",
  "required": [
    "baseline_experiment_id",
    "candidate_experiment_id",
    "baseline_accuracy_pct",
    "candidate_accuracy_pct",
    "accuracy_delta",
    "regressed",
    "threshold_pct",
    "regressed_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "baseline_experiment_id": { "type": "string" },
    "candidate_experiment_id": { "type": "string" },
    "baseline_accuracy_pct": { "type": "number" },
    "candidate_accuracy_pct": { "type": "number" },
    "accuracy_delta": { "type": "number" },
    "regressed": { "type": "boolean" },
    "threshold_pct": { "type": "number" },
    "regressed_cases": { "type": "array", "items": { "type": "string" } }
  }
}
